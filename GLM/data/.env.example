# Mistral Reverse Proxy 环境变量示例
# 用法：cp .env.example .env，然后编辑 .env，再 docker compose up -d --build
# .env 已被 .dockerignore 排除，不会进入镜像

# 管理界面登录密码（建议必填；为空则 UI 无密码保护）
ADMIN_PASSWORD=

# 上游 Mistral API key（单个）
UPSTREAM_API_KEY=

# 多 key 用逗号/分号/换行分隔（与 UPSTREAM_API_KEY 合并去重）
UPSTREAM_API_KEYS=

# 本地鉴权 key（逗号分隔多 key）；不设则首次启动自动生成并写入 data/keys.json
LOCAL_API_KEYS=

# 监听端口（宿主映射随此值自动变化）
PORT=38467

# 监听地址（留空 = 0.0.0.0 所有网卡）
HOST=

# 上游地址（一般无需改）
UPSTREAM_BASE_URL=https://api.mistral.ai/v1

# 全局出口代理（容器出网被墙/DNS 劫持时设置，优先级最高）
# 支持 socks5:// / socks5h:// / http:// / https://
UPSTREAM_PROXY=

# 请求未带 tools 时注入 Playground 默认工具
INJECT_PLAYGROUND_TOOLS=true

# 上游响应头超时（秒）。GLM high 深度思考单请求可能 60s+，长任务建议 1800
HTTP_TIMEOUT_SECONDS=120

# GLM 默认思考强度：none=最快(~2s) / high=深度思考(60s+，长任务易超时)
# 客户端显式传 reasoning_effort 时以此为准；未传时才用这里的默认值
DEFAULT_REASONING_EFFORT=none

# 上游失败时最多尝试的 key 数
MAX_UPSTREAM_RETRIES=4